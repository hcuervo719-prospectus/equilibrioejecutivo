<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Equilibrio Ejecutivo</title>
    <style>
      :root{--bg:#0f1113;--accent:#E0CCFA;--text:#e6e6e6}
      *{box-sizing:border-box}
      body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh}
      .page-container{max-width:780px;padding:32px;border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));box-shadow:0 6px 18px rgba(0,0,0,0.5);text-align:center}
      .page-title{font-size:28px;margin:0 0 8px;color:var(--accent)}
      .page-subtitle{margin:0 0 16px;color:#cfcfe0}
      .status-badge{display:inline-block;padding:8px 12px;border-radius:8px;background:rgba(224,204,250,0.08);color:var(--accent);font-weight:600}
      @media (max-width:600px){.page-container{padding:20px}}
    </style>
  </head>
  <body>
    <main class="page-container">
      <h1 class="page-title">App lista</h1>
      <p class="page-subtitle">La aplicación se ha inicializado correctamente y ahora responde en /</p>
      <div class="status-badge">Estado: operativo</div>
    </main>
  </body>
</html>
