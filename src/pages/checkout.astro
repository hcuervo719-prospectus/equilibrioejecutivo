<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Checkout — Equilibrio Ejecutivo</title>
    <meta name="description" content="Proceso de pago para Equilibrio Ejecutivo. Selecciona tu plan y completa el pago." />
    <script>
      try{
        const origDefine = customElements.define.bind(customElements);
        customElements.define = function(name, constructor){
          if(name === 'astro-dev-toolbar'){
            const Patched = class extends constructor {
              getAppTemplate(app){ if(!app) return ''; try{ return super.getAppTemplate(app);}catch(e){return ''} }
            };
            return origDefine(name, Patched);
          }
          return origDefine(name, constructor);
        }
      }catch(e){}
    </script>

    <!-- PayPal SDK (loaded from env PUBLIC_PAYPAL_CLIENT_ID) -->
    <script>
      (function(){
        try{
          const clientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || "BAATYrZqOfTQ0RLR0jkKZF2yvIJmyfld8IBBqqhFF6oAa-CpkXbrqjKyZpblietfhlH6ECnzwVRjsld_VA";
          const src = `https://www.paypal.com/sdk/js?client-id=${clientId}&components=hosted-buttons&disable-funding=venmo&currency=USD`;
          const existing = document.querySelector(`script[src^="https://www.paypal.com/sdk/js"]`);
          if(!existing){
            const s = document.createElement('script');
            s.src = src;
            s.async = true;
            document.head.appendChild(s);
          }
        }catch(e){console.warn('Could not load PayPal SDK via env', e)}
      })();
    </script>

    <style>
      :root{--blue:#1B365D;--gold:#F4D03F;--muted:#6B7280;--bg:#ffffff;--card:#f7f8fb;--text:#0f1724}
      *{box-sizing:border-box}
      body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial;background:var(--bg);color:var(--text)}
      .container{max-width:720px;margin:0 auto;padding:20px}
      header{display:flex;align-items:center;justify-content:space-between;padding:12px 0}
      .logo-img{width:44px;height:44px;border-radius:8px}
      .card{background:linear-gradient(180deg,#fff,var(--card));padding:18px;border-radius:12px}
      .summary{display:flex;justify-content:space-between;align-items:center}
      .price{font-size:22px;font-weight:800;color:var(--blue)}
      .btn{padding:12px 16px;border-radius:10px;border:0;cursor:pointer;font-weight:700}
      .btn-primary{background:var(--gold);color:var(--blue)}
      .notes{color:var(--muted);font-size:13px;margin-top:8px}
      footer{margin-top:24px;padding:18px;border-radius:10px;background:#0b1b33;color:#f6f7fa}
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <div style="display:flex;align-items:center;gap:12px">
          <img class="logo-img" src="https://cdn.builder.io/api/v1/image/assets%2Fb7400011ae9a4ecca8c90d62243bba6c%2Fed902ad33ece4df682caa88ec5080685?format=webp&width=800" alt="Prospectus" />
          <div style="font-weight:700;color:var(--blue)">Equilibrio Ejecutivo</div>
        </div>
        <nav>
          <button class="btn" onclick="location.href='/episodios'">Episodios</button>
        </nav>
      </header>

      <main>
        <h1>Checkout</h1>
        <p class="notes">Confirma tu plan y forma de pago. Los pagos se procesan a través de PayPal.</p>

        <section class="card" id="checkout-card">
          <div class="summary">
            <div>
              <div id="plan-name" style="font-weight:800;font-size:16px">Plan</div>
              <div id="plan-desc" style="color:var(--muted);font-size:13px">Descripción</div>
            </div>
            <div>
              <div class="price" id="plan-price">$0</div>
              <div style="font-size:12px;color:var(--muted);text-align:right">USD</div>
            </div>
          </div>

          <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap">
            <div id="paypal-container-HTRDZXWEBFE9S"></div>
            <script>
              // PayPal Hosted Button (Part 2)
              if (window.paypal && paypal.HostedButtons) {
                paypal.HostedButtons({
                  hostedButtonId: "HTRDZXWEBFE9S",
                }).render("#paypal-container-HTRDZXWEBFE9S");
              } else {
                // SDK not loaded yet — wait and retry
                const interval = setInterval(()=>{
                  if(window.paypal && paypal.HostedButtons){
                    clearInterval(interval);
                    paypal.HostedButtons({ hostedButtonId: "HTRDZXWEBFE9S" }).render("#paypal-container-HTRDZXWEBFE9S");
                  }
                }, 250);
              }
            </script>
            <button class="btn" onclick="location.href='/'">Cancelar</button>
          </div>

          <p class="notes">Al hacer click se abrirá la pasarela de pago. Después del pago serás redirigido a la página de confirmación.</p>
        </section>
      </main>

      <footer>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
          <div style="font-weight:800">Garantía de satisfacción 14 días</div>
          <div style="font-size:13px;color:#cbd5e1">© Prospectus Studio</div>
        </div>
      </footer>
    </div>

    <script type="module">
      // Populate from URL params
      const params = new URLSearchParams(window.location.search);
      const plan = params.get('plan') || 'pioneros';
      const amount = params.get('amount') || (plan==='estandar' ? '49' : '29');

      const planName = plan==='estandar' ? 'Estándar' : 'Pioneros';
      document.getElementById('plan-name').textContent = planName;
      document.getElementById('plan-desc').textContent = plan==='estandar' ? 'Acceso completo — mejor para equipos' : 'Precio especial para primeros inscritos';
      document.getElementById('plan-price').textContent = '$' + amount;

      // Payment is handled by PayPal Hosted Buttons embedded above; no generic pay-button handler required.
    </script>
  </body>
</html>
