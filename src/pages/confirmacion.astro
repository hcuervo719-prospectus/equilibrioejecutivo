<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Confirmación — Equilibrio Ejecutivo</title>
    <meta name="description" content="Confirmación de compra de Equilibrio Ejecutivo. Gracias por tu compra." />
    <script>
      try{
        const origDefine = customElements.define.bind(customElements);
        customElements.define = function(name, constructor){
          if(name === 'astro-dev-toolbar'){
            const Patched = class extends constructor {
              getAppTemplate(app){ if(!app) return ''; try{ return super.getAppTemplate(app);}catch(e){return ''} }
            };
            return origDefine(name, Patched);
          }
          return origDefine(name, constructor);
        }
      }catch(e){}
    </script>
    <style>
      :root{--blue:#1B365D;--gold:#F4D03F;--muted:#6B7280;--bg:#ffffff;--card:#f7f8fb;--text:#0f1724}
      *{box-sizing:border-box}
      body{margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial;background:var(--bg);color:var(--text)}
      .container{max-width:720px;margin:0 auto;padding:20px}
      header{display:flex;align-items:center;justify-content:space-between;padding:12px 0}
      .logo-img{width:44px;height:44px;border-radius:8px}
      .card{background:linear-gradient(180deg,#fff,var(--card));padding:18px;border-radius:12px}
      .success{color:var(--blue);font-weight:800}
      .small{color:var(--muted);font-size:13px}
      footer{margin-top:24px;padding:18px;border-radius:10px;background:#0b1b33;color:#f6f7fa}
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <div style="display:flex;align-items:center;gap:12px">
          <img class="logo-img" src="https://cdn.builder.io/api/v1/image/assets%2Fb7400011ae9a4ecca8c90d62243bba6c%2Fed902ad33ece4df682caa88ec5080685?format=webp&width=800" alt="Prospectus" />
          <div style="font-weight:700;color:var(--blue)">Equilibrio Ejecutivo</div>
        </div>
        <nav>
          <button onclick="location.href='/'">Inicio</button>
        </nav>
      </header>

      <main>
        <section class="card">
          <h1 class="success">¡Reserva Confirmada!</h1>
          <p class="small">Te has unido como <strong>Pionero de Equilibrio Ejecutivo</strong></p>

          <div class="timeline-info" style="margin-top:12px">
            <h3>Fechas importantes:</h3>
            <ul>
              <li><strong>23 Octubre 2025:</strong> Estreno Episodio 1</li>
              <li><strong>8 Enero 2026:</strong> Serie completa disponible</li>
              <li><strong>Acceso:</strong> De por vida una vez iniciada la serie</li>
            </ul>
          </div>

          <p class="small"><strong>Próximos pasos:</strong></p>
          <p class="small">1. Recibirás email de confirmación con tu número de reserva</p>
          <p class="small">2. Te notificaremos 48 horas antes del estreno</p>
          <p class="small">3. El 23 de octubre recibirás tu enlace de acceso</p>

          <div style="margin-top:12px;display:flex;gap:10px">
            <button class="btn" onclick="location.href='/episodios'">Ver episodios</button>
            <button class="btn btn-primary" onclick="location.href='/'">Volver al inicio</button>
          </div>
        </section>
      </main>

      <footer>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
          <div style="font-weight:800">Garantía de satisfacción 14 días</div>
          <div style="font-size:13px;color:#cbd5e1">© Prospectus Studio</div>
        </div>
      </footer>
    </div>

    <script type="module">
      const params = new URLSearchParams(window.location.search);
      document.getElementById('plan').textContent = params.get('plan') || '-';
      document.getElementById('amount').textContent = params.get('amount') ? ('$' + params.get('amount') + ' USD') : '-';
      document.getElementById('provider').textContent = params.get('provider') || '-';
      document.getElementById('order').textContent = params.get('order') || (Math.random().toString(36).slice(2,9).toUpperCase());

      // Analytics event
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({event:'purchase_complete',plan:params.get('plan'),amount:params.get('amount'),order:params.get('order')});
    </script>
  </body>
</html>
